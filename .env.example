# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/senbiopest?schema=public"

# JWT
JWT_SECRET="change-me-in-production-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# App
API_PORT=3001
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER="+221XXXXXXXXX"

# Upload
UPLOAD_DIR="./uploads"
# S3 (production)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=

# Email notifications (optional). SMTP_HOST=log prints the e-mails in the API logs instead of sending them.
# SMTP_HOST=smtp.mail.ovh.net
# SMTP_PORT=465
# SMTP_USER=contact@senbiopest.com
# SMTP_PASS=
# EMAIL_FROM=Sen Biopest <contact@senbiopest.com>
# NOTIFY_EMAIL=contact@senbiopest.com   # where new requests are announced (default: SMTP_USER)
