{
  "name": "sen-biopest",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:generate": "pnpm --filter prisma-config generate",
    "db:push": "pnpm --filter prisma-config db:push",
    "db:migrate": "pnpm --filter prisma-config migrate:dev",
    "db:seed": "pnpm --filter prisma-config seed",
    "db:studio": "pnpm --filter prisma-config studio"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
