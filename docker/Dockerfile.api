# syntax=docker/dockerfile:1
# Build: docker build -f docker/Dockerfile.api -t senbiopest-api .
FROM node:20-alpine AS base
RUN apk add --no-cache openssl \
 && corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

# ---- build ----
FROM base AS build
COPY . .
RUN pnpm install --frozen-lockfile --filter @sen-biopest/api... --filter prisma-config
RUN pnpm --filter prisma-config exec prisma generate
RUN pnpm --filter @sen-biopest/api build
# Self-contained production folder (real files, no workspace symlinks)
RUN pnpm --filter @sen-biopest/api deploy --prod /out \
 && cp -r prisma /out/prisma \
 && cd /out && ./node_modules/.bin/prisma generate --schema prisma/schema.prisma

# ---- runtime ----
FROM node:20-alpine AS runner
RUN apk add --no-cache openssl
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build --chown=node:node /out ./
RUN mkdir -p uploads && chown node:node uploads
USER node
EXPOSE 3001
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
  CMD wget -qO- http://127.0.0.1:3001/api/health || exit 1
# Apply pending database migrations, then start the API
CMD ["sh", "-c", "./node_modules/.bin/prisma migrate deploy --schema prisma/schema.prisma && node dist/main"]
