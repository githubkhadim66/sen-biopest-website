# HTTPS certificates are obtained automatically for {$DOMAIN} (DNS must point to this server)
{$DOMAIN} {
	encode zstd gzip

	@api path /api/* /uploads/*
	handle @api {
		request_body {
			max_size 12MB
		}
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
