# Copy to .env on the server, fill in, then:
#   docker compose -f docker/docker-compose.yml --env-file .env up -d --build

# Domain name (DNS A record must point to the server; HTTPS is automatic)
DOMAIN=senbiopest.com

# Database
POSTGRES_DB=senbiopest
POSTGRES_USER=senbiopest
POSTGRES_PASSWORD=          # openssl rand -hex 24

# Auth secrets: 32+ random characters each, different from each other
JWT_SECRET=                 # openssl rand -hex 32
JWT_REFRESH_SECRET=         # openssl rand -hex 32
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Public WhatsApp number (international format)
WHATSAPP_NUMBER=+221770000000
